{
  "manifest_version": 3,
  "name": "Browser Agent",
  "version": "0.1.0",
  "description": "AI agent that reads and acts on your browser tabs. Runs fully local (ONNX, WebLLM, or wllama/GGUF) or via Ollama/Gemini/OpenAI/Anthropic.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "activeTab",
    "sidePanel",
    "offscreen",
    "declarativeNetRequest",
    "downloads",
    "debugger"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ollama_cors",
        "enabled": true,
        "path": "llm-API/ollama-cors.json"
      }
    ]
  },
  "host_permissions": [
    "<all_urls>",
    "https://integrate.api.nvidia.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "UI/sidepanel.html"
  },
  "action": {
    "default_title": "Browser Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "sandbox": {
    "pages": ["modes/WebApp/sandbox.html"]
  },
  "cross_origin_embedder_policy": {
    "value": "credentialless"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "web_accessible_resources": [
    {
      "resources": ["llm-browser/vendor/transformers/*", "llm-browser/vendor/webllm/*", "llm-browser/vendor/wllama/*", "vendor/pdf/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
